---
import legal from "@/data/legal.json";
import Base from "@/layouts/Base.astro";

export function getStaticPaths() {
  return Object.entries(legal).map(([slug, v]) => ({ params: { slug }, props: v }));
}
const { title, html } = Astro.props;
---

<Base title={`${title} | Hydraumatics General Dealers`}>
  <article class="mx-auto max-w-3xl px-5 py-14">
    <a href="/legal" class="text-primary-accent text-sm underline">← All legal information</a>
    <h1 class="mt-3 mb-6 text-5xl font-bold">{title}</h1>
    <div class="legal-body [&_h4]:mt-5 [&_h4]:mb-1 [&_h4]:font-semibold [&_p]:mb-3 [&_p]:max-w-[70ch] [&_ul]:mb-3 [&_ul]:list-disc [&_ul]:pl-5" set:html={html} />
  </article>
</Base>
