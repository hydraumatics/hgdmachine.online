---
import { Button } from "@/components/starwind/button";
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found | Hydraumatics General Dealers">
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="text-primary-accent font-heading text-7xl">404</p>
    <h1 class="mt-2 text-4xl font-bold">We couldn’t find that page</h1>
    <p class="text-muted-foreground mt-3">It may have moved, or the product may no longer be listed.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><Button href="/shop" variant="primary" size="lg">Browse the shop</Button><Button href="/#quote" variant="outline" size="lg">Request a quote</Button></div>
  </section>
</Base>
