---
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Checkbox } from "@/components/starwind/checkbox";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { NativeSelect } from "@/components/starwind/native-select";
import Base from "@/layouts/Base.astro";
import { getAllProducts, isInsurance, type Product } from "@/lib/shopify";
import { imgUrl, isQuoteOnly, money } from "@/lib/utils";

export async function getStaticPaths() {
  const all = await getAllProducts();
  const ins = all.filter(isInsurance);
  return all.filter((p) => !isInsurance(p)).map((p) => ({ params: { handle: p.handle }, props: { p, ins } }));
}
const { p, ins } = Astro.props as { p: Product; ins: Product[] };
const cur = p.variants[0].price.currencyCode;
const prices = p.variants.map((v) => Number(v.price.amount));
const quoteOnly = isQuoteOnly(prices, p.tags) || !p.variants.some((v) => v.availableForSale);
const data = {
  cur, handle: p.handle, title: p.title,
  variants: p.variants.map((v) => ({ id: v.id, title: v.title, price: Number(v.price.amount) })),
  ins: ins.map((i) => ({ title: i.title, desc: i.description, variants: i.variants.map((v) => ({ id: v.id, title: v.title, price: Number(v.price.amount) })) })),
};
const jsonLd = {
  "@context": "https://schema.org", "@type": "Product", name: p.title, description: p.description || p.title, sku: p.handle, category: p.productType,
  brand: { "@type": "Brand", name: "Hydraumatics General Dealers" },
  ...(p.featuredImage ? { image: p.featuredImage.url } : {}),
  ...(!quoteOnly ? { offers: { "@type": "Offer", priceCurrency: cur, price: Math.min(...prices), availability: "https://schema.org/InStock", url: new URL(`/products/${p.handle}`, Astro.site).href } } : {}),
};
---

<Base title={`${p.title} | Hydraumatics General Dealers`} description={(p.description || `${p.title} supplied in Zambia.`).slice(0, 155)} type="product" image={p.featuredImage?.url}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="mx-auto grid max-w-6xl gap-10 px-5 pt-10 lg:grid-cols-2">
    <div class="bg-card border-border grid aspect-[4/3] place-items-center overflow-hidden rounded-xl border">
      {p.featuredImage ? <img src={imgUrl(p.featuredImage.url, 1000)} alt={p.featuredImage.altText ?? p.title} width="1000" height="750" class="h-full w-full object-cover" transition:name={`img-${p.handle}`} /> : <span class="font-heading text-muted-foreground px-6 text-center text-4xl">{p.productType}</span>}
    </div>

    <div>
      <a href="/shop" class="text-primary-accent text-sm underline">← Back to the shop</a>
      <p class="text-muted-foreground mt-3 text-xs tracking-wide uppercase">{p.productType}</p>
      <h1 class="text-4xl font-bold md:text-5xl">{p.title}</h1>
      <div class="mt-2 flex gap-2">{p.tags.includes("Fast-Moving") && <Badge variant="primary" size="sm">Fast-moving</Badge>}{p.tags.includes("Special-Order") && <Badge variant="outline" size="sm">Special order</Badge>}</div>
      <p id="price" class="mt-3 text-2xl font-semibold" aria-live="polite">{quoteOnly ? "Quote on request" : ""}</p>
      {p.descriptionHtml && <div class="text-muted-foreground mt-3 [&_p]:mb-3" set:html={p.descriptionHtml} />}

      {p.variants.length > 1 && <div class="mt-4 grid gap-2"><Label for="variant">Option</Label><NativeSelect id="variant">{p.variants.map((v) => <option value={v.id}>{v.title} – {money(v.price.amount, cur)}</option>)}</NativeSelect></div>}
      {!quoteOnly && <div class="mt-4 grid max-w-40 gap-2"><Label for="qty">Quantity</Label><Input id="qty" type="number" min="1" max="999" value="1" inputmode="numeric" /></div>}

      {!quoteOnly && ins.length > 0 && (
        <fieldset class="border-border bg-card mt-6 rounded-xl border p-4">
          <legend class="font-heading px-1 text-2xl font-bold">Protect this order (optional)</legend>
          <p class="text-muted-foreground text-sm">Choose one or more covers. Pick a cover limit at or above the value of your order.</p>
          <div class="mt-3 space-y-3">
            {data.ins.map((i, k) => (
              <div class="border-border rounded-lg border p-3">
                <Checkbox id={`cov-${k}`} data-k={k} label={i.title} />
                <p class="text-muted-foreground mt-1 ml-8 text-sm">{i.desc}</p>
                <div class="mt-2 ml-8 grid gap-1"><Label for={`covsel-${k}`} class="text-sm">Cover limit for {i.title}</Label>
                  <NativeSelect id={`covsel-${k}`} data-sel={k} disabled>{i.variants.map((v) => <option value={v.id}>{v.title} – premium {money(v.price, cur)}</option>)}</NativeSelect></div>
              </div>
            ))}
          </div>
          <p class="text-muted-foreground mt-3 text-xs">Cover is arranged subject to the insurer’s policy terms and exclusions. See our <a class="underline" href="/legal/terms">Terms of sale</a>.</p>
        </fieldset>
      )}

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        {!quoteOnly && <Button id="add" type="button" variant="primary" size="lg" class="flex-1">Add to cart</Button>}
        <Button href={`/?item=${encodeURIComponent(p.title)}#quote`} variant={quoteOnly ? "primary" : "outline"} size="lg" class="flex-1">Request a quote</Button>
      </div>
      <p id="msg" class="mt-3 text-sm text-red-700 dark:text-red-400" role="alert"></p>
      <ul class="text-muted-foreground mt-6 space-y-1 text-sm"><li>OEM and quality aftermarket options on request</li><li>Warranty and lead time confirmed on quotation</li><li>Send your make, model and serial number so we can confirm fitment</li></ul>
    </div>
  </section>

  <script type="application/json" id="pdata" set:html={JSON.stringify(data)} />
  <script>
    import { addToCart, type NewLine } from "@/lib/cart";
    import { money, suggestCover } from "@/lib/utils";

    interface V { id: string; title: string; price: number }
    interface PData { cur: string; title: string; variants: V[] }

    document.addEventListener("astro:page-load", () => {
      const raw = document.getElementById("pdata");
      if (!raw?.textContent) return;
      const d: PData = JSON.parse(raw.textContent);
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
      const vsel = $<HTMLSelectElement>("variant"), qty = $<HTMLInputElement>("qty"), add = $<HTMLButtonElement>("add"), msg = $("msg"), price = $("price");
      if (!add || !qty || !price || !msg) return;
      const variant = () => d.variants.find((v) => v.id === vsel?.value) ?? d.variants[0];
      const count = () => Math.min(999, Math.max(1, Math.floor(Number(qty.value)) || 1));

      function refresh() {
        const v = variant(), n = count();
        price!.textContent = money(v.price * n, d.cur) + (n > 1 ? ` (${money(v.price, d.cur)} each)` : "");
        document.querySelectorAll<HTMLSelectElement>("[data-sel]").forEach((s) => {
          if (s.dataset.touched) return;
          const opts = [...s.options].map((o) => ({ title: o.text, value: o.value }));
          const pick = suggestCover(opts, v.price * n);
          if (pick) s.value = pick.value; // suggest the smallest cover limit that covers the order
        });
      }
      vsel?.addEventListener("change", refresh);
      qty.addEventListener("input", refresh);
      document.querySelectorAll<HTMLInputElement>("[data-k]").forEach((c) => c.addEventListener("change", () => { const s = document.querySelector<HTMLSelectElement>(`[data-sel="${c.dataset.k}"]`); if (s) s.disabled = !c.checked; }));
      document.querySelectorAll<HTMLSelectElement>("[data-sel]").forEach((s) => s.addEventListener("change", () => (s.dataset.touched = "1")));

      add.addEventListener("click", async () => {
        msg.textContent = "";
        add.disabled = true;
        const label = add.textContent;
        add.textContent = "Adding…";
        try {
          const lines: NewLine[] = [{ merchandiseId: variant().id, quantity: count() }];
          document.querySelectorAll<HTMLInputElement>("[data-k]:checked").forEach((c) => {
            const s = document.querySelector<HTMLSelectElement>(`[data-sel="${c.dataset.k}"]`);
            if (s) lines.push({ merchandiseId: s.value, quantity: 1, attributes: [{ key: "Covers", value: d.title }] });
          });
          await addToCart(lines);
        } catch {
          msg.textContent = "Could not add to cart. Please try again or request a quote.";
        } finally {
          add.disabled = false;
          add.textContent = label;
        }
      });
      refresh();
    });
  </script>
</Base>
