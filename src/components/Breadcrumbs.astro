---
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="text-muted-foreground flex flex-wrap items-center gap-x-2">
    {items.map((it, i) => (
      <li class="flex items-center gap-x-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {it.href && i < items.length - 1
          ? <a href={it.href} class="text-primary-accent inline-block py-1 underline">{it.name}</a>
          : <span aria-current="page" class="text-foreground">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
