---
import { Picture } from "astro:assets";
import { findImage, imageFocus } from "@/lib/images";

interface Props {
  name: string;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  focus?: string;
}
const { name, alt, sizes, widths = [480, 800, 1200], loading = "lazy", fetchpriority, class: className, focus } = Astro.props;
const { meta, publicSrc, sources = [] } = findImage(name);
const style = `object-position:${focus ?? imageFocus[name] ?? "50% 50%"}`;
---

{meta
  ? <Picture src={meta} alt={alt} widths={widths} sizes={sizes} formats={["avif", "webp"]} fallbackFormat="jpg" loading={loading} decoding="async" fetchpriority={fetchpriority} class={className} style={style} />
  : publicSrc
    ? <picture>{sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizes} />)}<img src={publicSrc} alt={alt} loading={loading} decoding="async" fetchpriority={fetchpriority} class={className} style={style} /></picture>
    : null}
