---
// Decorative engineering drawing of a hydraulic cylinder for the hero. No text, hidden from assistive tech.
// Motion: the outline draws once on page load, then the piston rod extends. Reduced motion: shown finished.
---

<svg class="cyl" viewBox="0 0 580 320" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="cyl-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="7" class="hatch"></line>
    </pattern>
  </defs>

  <line class="centre" x1="20" y1="160" x2="570" y2="160"></line>

  <g class="body">
    <rect x="110" y="90" width="270" height="14" fill="url(#cyl-hatch)"></rect>
    <rect x="110" y="216" width="270" height="14" fill="url(#cyl-hatch)"></rect>
    <path class="s" pathLength="1" d="M110 90H380V230H110Z"></path>
    <path class="s" pathLength="1" d="M130 104H380M130 216H380"></path>
    <path class="s" pathLength="1" d="M90 84H130V236H90Z"></path>
    <path class="s" pathLength="1" d="M380 96H410V224H380Z"></path>
    <path class="s" pathLength="1" d="M170 90V68H198V90"></path>
    <path class="s" pathLength="1" d="M320 90V68H348V90"></path>
    <circle class="s" pathLength="1" cx="62" cy="160" r="22"></circle>
    <circle class="s" pathLength="1" cx="62" cy="160" r="8"></circle>
    <path class="s" pathLength="1" d="M84 148H90M84 172H90"></path>
  </g>

  <g class="rod">
    <rect class="piston" x="250" y="108" width="22" height="104"></rect>
    <path class="g" d="M272 146H520M272 174H520"></path>
    <path class="g" d="M520 140H548V180H520Z"></path>
    <circle class="g" cx="534" cy="160" r="9"></circle>
  </g>

  <g class="dim">
    <path class="g" d="M90 244V286M410 232V286M90 274H410"></path>
    <path class="fill" d="M90 274L103 269.5V278.5ZM410 274L397 269.5V278.5Z"></path>
  </g>
</svg>

<style>
  .cyl { width: 100%; height: auto; display: block; }
  .s, .g { stroke-width: 2; stroke-linejoin: round; }
  .s { stroke: rgb(255 255 255 / 0.62); }
  .g { stroke: var(--primary); }
  .fill { fill: var(--primary); stroke: none; }
  .piston { fill: rgb(207 153 49 / 0.2); stroke: var(--primary); stroke-width: 2; }
  .hatch { stroke: rgb(255 255 255 / 0.32); stroke-width: 1; }
  .centre { stroke: var(--primary); stroke-width: 1.2; stroke-dasharray: 14 5 2 5; opacity: 0.55; }

  @media (prefers-reduced-motion: no-preference) {
    .s { stroke-dasharray: 1; animation: draw 1.5s cubic-bezier(0.4, 0, 0.2, 1) backwards; }
    .rod { animation: extend 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 1.2s backwards; }
    .dim, .centre { animation: appear 0.9s ease-out 2.2s backwards; }
  }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  @keyframes extend { from { transform: translateX(-110px); } }
  @keyframes appear { from { opacity: 0; } }
</style>
